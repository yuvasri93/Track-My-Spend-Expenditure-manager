{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Django Backend",
      "type": "shell",
      "command": "python manage.py runserver 127.0.0.1:8000",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "servers"
      },
      "isBackground": true
    },
    {
      "label": "Run React Frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "servers"
      },
      "isBackground": true
    }
  ]
}
